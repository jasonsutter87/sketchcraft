# Canary Island palm, about 7.5 m. Origin: base of the trunk.
{"cmd":"begin_group","name":"Trunk","as":"trunk"}
{"cmd":"circle","center":[0,0,0],"radius":0.3,"segments":10,"as":"t"}
{"cmd":"pushpull","face":"@t","distance":7,"as":"tt"}
{"cmd":"scale","ids":["@tt"],"center":[0,0,7],"factor":[0.7,0.7,1]}
{"cmd":"end_group"}
{"cmd":"paint","ids":["@trunk"],"color":[0.55,0.45,0.33]}
{"cmd":"begin_group","name":"Fronds","as":"fronds"}
{"cmd":"polygon","points":[[0,0,7],[2.2,0.3,6.6],[2.8,0,6.0]],"as":"f1"}
{"cmd":"polygon","points":[[0,0,7],[2.8,0,6.0],[2.2,-0.3,6.6]]}
{"cmd":"end_group"}
{"cmd":"paint","ids":["@fronds"],"color":[0.33,0.52,0.28]}
{"cmd":"duplicate","ids":["@fronds"],"by":[0,0,0],"as":"r0"}
{"cmd":"rotate","ids":["@r0"],"center":[0,0,0],"angle":60}
{"cmd":"duplicate","ids":["@fronds"],"by":[0,0,0],"as":"r1"}
{"cmd":"rotate","ids":["@r1"],"center":[0,0,0],"angle":120}
{"cmd":"duplicate","ids":["@fronds"],"by":[0,0,0],"as":"r2"}
{"cmd":"rotate","ids":["@r2"],"center":[0,0,0],"angle":180}
{"cmd":"duplicate","ids":["@fronds"],"by":[0,0,0],"as":"r3"}
{"cmd":"rotate","ids":["@r3"],"center":[0,0,0],"angle":240}
{"cmd":"duplicate","ids":["@fronds"],"by":[0,0,0],"as":"r4"}
{"cmd":"rotate","ids":["@r4"],"center":[0,0,0],"angle":300}
