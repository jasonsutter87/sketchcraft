<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider may hand to another app: only a "shared" folder inside the app's own cache. The Tauri
     template listed all of shared storage ("external-path path=.") and the whole cache; nothing in SketchCraft needs
     either (files come in and go out through the system file picker). The provider itself is not exported. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="shared" path="shared/" />
</paths>
